# Set these in Netlify UI > Site configuration > Environment variables.
# Netlify Database supplies NETLIFY_DB_URL after the database is enabled.
NETLIFY_SESSION_SECRET=
APP_URL=https://your-site.netlify.app
MAIL_FROM=
RESEND_API_KEY=

# Only when importing the existing local MySQL data:
MYSQL_HOST=localhost
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
